# Copy to .env and fill in.
# Comfy API v2 surface. Local: comfy-api-proxy in front of ComfyUI (scripts/comfy-proxy.sh).
# Comfy Cloud: leave COMFY_BASE_URL empty and set COMFY_API_KEY (platform.comfy.org); every
# workflow's nodes and models are on Cloud. scripts/set_fill.py still runs on this machine.
# A faster ComfyUI (another machine, a rented GPU): point both here, then check it has every
# node and model the graphs use: node scripts/comfy-check.ts http://<host>:8188
COMFY_BASE_URL=http://127.0.0.1:8189
# Only for Comfy Cloud / serverless. Leave empty for the local proxy.
# With a key, COMFY_BASE_URL must be empty or the key is sent to that server instead.
COMFY_API_KEY=
# Python with torch, trimesh, cv2 and scipy, for scripts/set_fill.py (default: ~/ComfyUI/.venv/bin/python).
NIFL_PYTHON=
COMFYUI_URL=http://127.0.0.1:8188
